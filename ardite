#!/bin/sh
# Runs ardite.js with the Node.js bundled in runtime/ (release packages), otherwise the installed one.
# Usage: ./ardite install | start | stop | restart | status | open | update | uninstall
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
node="$dir/runtime/node"
if [ ! -x "$node" ]; then
  node=$(command -v node) || {
    echo "  Node.js not found. Install Node.js 20 or newer, or use a release package." >&2
    exit 1
  }
fi
exec "$node" "$dir/ardite.js" "$@"
